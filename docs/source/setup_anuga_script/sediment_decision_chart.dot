// Sediment decision chart for the "Sediment transport" setup page.
// Generated by make_sediment_decision_chart.py -- edit that, not this.
digraph sediment_choices {
  graph [rankdir=TB, nodesep=0.18, ranksep=0.35, fontname="Helvetica", bgcolor="transparent"];
  node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", penwidth=1, margin="0.12,0.06"];
  edge  [color="#4a78c2", penwidth=1.4, arrowsize=0.7];
  start [label="add_sediment_fraction(name, diameter)\nfor each grain size", fillcolor="#f3f4f6", color="#7b8794"];
  done  [label="print(domain.sediment_summary())\nthen calibrate against data", fillcolor="#f3f4f6", color="#7b8794"];
  q1 [label="1  What is the bed made of?", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q1_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Sand, gravel, or mud that moves as flocs</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_bed_material('noncohesive')</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">entrainment='smith_mclean'&#160;(default),</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">or&#160;'de_leeuw'&#160;for&#160;sand&#160;rivers&#160;and&#160;deltas</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>Clay or silt that binds</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_bed_material('cohesive',&#160;tau_crit=...)</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">tau_crit&#160;in&#160;Pa,&#160;ideally&#160;from&#160;a&#160;jet&#160;test</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  q2 [label="2  How does it move?\nRouse number Z = w_s / (0.41 u*)", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q2_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Z above 2.5: bedload only</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_bedload('wong_parker_eq24')</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Z from 0.8 to 2.5: both</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_bedload(...)&#160;as&#160;well</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>Z below 0.8: suspension</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">no&#160;bedload&#160;(the&#160;default)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  q3 [label="3  Is the suspension stratified?", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q3_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Yes, Z above about 0.1</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_deposition(near_bed='rouse')</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>No, well mixed</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">keep&#160;d*&#160;=&#160;1&#160;(the&#160;default)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  q4 [label="4  What sets the bed shear?", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q4_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Open channel or floodplain</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">the&#160;defaults:&#160;'quadratic_drag'</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">with&#160;the&#160;domain's&#160;Manning&#160;n</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>Vegetation</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_vegetation_drag(...,</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">&#160;&#160;&#160;&#160;sediment_shear='bed')</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  q5 [label="5  How much of the bed can erode?", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q5_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>A layer over rock, or a lining</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_erodible_base(depth=...)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Only part may scour</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_erodible_region(...)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>Banks or holes that should slump</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_angle_of_repose(35.0)</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  q6 [label="6  Several grain sizes, and\nthe bed sorts them?", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q6_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>Yes: mud over sand, armouring</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_bed_composition(fractions,</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">&#160;&#160;&#160;&#160;active_layer=0.01)</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">after&#160;set_erodible_base</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  q7 [label="7  Is the bed much slower\nthan the flow?", fillcolor="#e8f0fb", color="#4a78c2", width=2.9];
  q7_o [shape=plain, style="", label=<<TABLE BORDER="1" COLOR="#9aa5b1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="ROUNDED"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4" SIDES="B" BORDER="1"><B>Days to years of bed change</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">set_sediment_parameters(</FONT><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">&#160;&#160;&#160;&#160;morphological_factor=M)</FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><B>A fixed bed (analytic check)</B><BR ALIGN="LEFT"/><FONT FACE="Courier" POINT-SIZE="11">bed_evolution=False</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  start -> q1;
  q1 -> q2 -> q3 -> q4 -> q5 -> q6 -> q7 -> done;
  {rank=same; q1; q1_o;}
  q1 -> q1_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
  {rank=same; q2; q2_o;}
  q2 -> q2_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
  {rank=same; q3; q3_o;}
  q3 -> q3_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
  {rank=same; q4; q4_o;}
  q4 -> q4_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
  {rank=same; q5; q5_o;}
  q5 -> q5_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
  {rank=same; q6; q6_o;}
  q6 -> q6_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
  {rank=same; q7; q7_o;}
  q7 -> q7_o [style=dashed, color="#9aa5b1", arrowhead=none, penwidth=1];
}
